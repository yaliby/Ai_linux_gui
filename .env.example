# העתק ל-.env ושנה מה שצריך. משתנה שכבר קיים בסביבה תמיד גובר על הקובץ הזה.
# (‏.env נטען אוטומטית ב-server.js; אין צורך בחבילה חיצונית.)

# ---------- השרת ----------
# פורט הממשק המקומי (המאזין המרוחק עולה על PORT+1)
PORT=4173
# כתובת LAN מפורשת למאזין המרוחק. ריק = בחירה אוטומטית של כתובת ה-IPv4 הפרטית.
# RTL_HOST=192.168.1.20
# פורט מפורש למאזין המרוחק במקום PORT+1
# REMOTE_PORT=4174

# ---------- ספק: claude-code-router (מודלי Gemini חינמיים) ----------
# שער מקומי שמדבר Anthropic. אם אינו רץ — מדלגים עליו בשקט.
CCR_GATEWAY_URL=http://127.0.0.1:3456

# ---------- ספק: OmniRoute (תואם OpenAI) ----------
# הרמה: npm run omni:up   ·   הכל ביחד: npm run dev:all
#
# כתובת הבסיס של OmniRoute, כולל /v1. המודלים נשלפים חי מ-GET {BASE_URL}/models
# ומופיעים בבורר המודלים עם התחילית `omniroute/`.
OMNIROUTE_BASE_URL=http://localhost:3000/v1
# הפורט בצד המארח שאליו ממופה המכולה ב-docker-compose.yml.
# חייב להתאים לפורט שב-OMNIROUTE_BASE_URL. (בתוך המכולה זה תמיד 20128.)
OMNIROUTE_PORT=3000
# התקנה טרייה של OmniRoute אינה מחייבת מפתח, ולכן ברירת המחדל הזו עובדת כמו
# שהיא. אם הפעלת אימות בדאשבורד — העתק לכאן את המפתח מ-Endpoints.
OMNIROUTE_API_KEY=omniroute-local
# תקרת זמן לתור בודד מול OmniRoute (מילישניות). ברירת מחדל 600000 = 10 דקות.
# OMNIROUTE_TIMEOUT_MS=600000
# סינון בורר המודלים לפי בריאות: בדיקת ping קצרה ברקע, בלי סכמת הכלים של Claude.
# 0 מכבה את הסינון ומחזיר את כל רשימת /v1/models (חוץ מהטמעות ומודלים בלי כלים).
# חל גם על שאר הספקים תואמי-OpenAI, כי הבדיקה יושבת בגשר המשותף.
# OMNIROUTE_HEALTH_PROBE=1
# OMNIROUTE_HEALTH_CONCURRENCY=2
# OMNIROUTE_HEALTH_TIMEOUT_MS=12000
# TTL להצלחה, לכשל רך (429/503) ולכשל קשיח (404/403/CLI חסר), במילישניות.
# OMNIROUTE_HEALTH_TTL_MS=1800000
# OMNIROUTE_HEALTH_COOLING_MS=180000
# OMNIROUTE_HEALTH_UNHEALTHY_MS=900000
# כמה זמן להציג מודלים שטרם נבדקו, ורק עד שחוזרת תוצאה ראשונה.
# OMNIROUTE_HEALTH_GRACE_MS=15000

# ---------- ספק: מודלים מקומיים (LM Studio / Ollama / vLLM) ----------
# כל שרת תואם-OpenAI ברשת המקומית. המודלים נשלפים חי מ-GET {BASE_URL}/models
# ומופיעים בבורר המודלים עם התחילית `local/` והסיומת "· מקומי".
# ריק (LOCAL_BASE_URL=) מכבה את הספק לגמרי. שרת שאינו רץ פשוט לא יוסיף מודלים.
LOCAL_BASE_URL=http://192.168.1.253:1234/v1
# שרת מקומי לרוב אינו מחייב מפתח, והערך הזה נשלח רק כדי לספק את הכותרת.
LOCAL_API_KEY=local
# תקרת זמן לתור בודד (מילישניות). ברירת מחדל 600000 = 10 דקות. מודל גדול על
# חומרה צנועה עשוי להצדיק ערך גבוה יותר.
# LOCAL_TIMEOUT_MS=600000

# ---------- המכולה של OmniRoute (docker-compose.yml) ----------
# תגית האימג'. `latest` יציב; `main`/`next` הן גרסאות פיתוח.
# OMNIROUTE_IMAGE_TAG=latest
# תקרת זיכרון ל-Node בתוך המכולה (MB)
# OMNIROUTE_MEMORY_MB=512
