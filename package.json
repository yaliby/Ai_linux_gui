{
  "name": "rtl-claude",
  "version": "1.0.0",
  "description": "ממשק גרפי RTL סביב Claude Code CLI",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "omni:up": "docker compose up -d --wait",
    "omni:down": "docker compose down",
    "omni:restart": "docker compose restart omniroute",
    "omni:logs": "docker compose logs -f omniroute",
    "omni:status": "docker compose ps",
    "dev:all": "npm run omni:up || echo \"\\n  ⚠ OmniRoute לא עלה — הממשק ימשיך בלעדיו\\n\"; node server.js",
    "test": "node test/openai-bridge.test.mjs"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.10.0",
    "dompurify": "^3.1.6",
    "express": "^4.19.2",
    "marked": "^12.0.2",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
